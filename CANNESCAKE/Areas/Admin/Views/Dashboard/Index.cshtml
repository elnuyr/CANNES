@model CANNESCAKE.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="d-flex justify-content-between flex-wrap">
            <div class="d-flex align-items-end flex-wrap">
                <div class="me-md-3 me-xl-5">
                    <h2 class="welcome-text">Xoş gəlmisiniz, <span class="text-black fw-bold">Admin</span></h2>
                    <p class="mb-md-0 text-muted">CANNESCAKE idarəetmə panelinə baxış.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Stat Cards -->
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card shadow-sm border-0 bg-gradient-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2 text-white-50">Sifarişlər</p>
                        <h3 class="mb-0">@Model.OrdersCount</h3>
                    </div>
                    <div class="icon-box-white">
                        <i class="mdi mdi-cart-outline icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card shadow-sm border-0 bg-gradient-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2 text-white-50">Tortlar</p>
                        <h3 class="mb-0">@Model.CakesCount</h3>
                    </div>
                    <div class="icon-box-white">
                        <i class="mdi mdi-cake-variant icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card shadow-sm border-0 bg-gradient-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2 text-white-50">Mesajlar</p>
                        <h3 class="mb-0">@Model.MessagesCount</h3>
                    </div>
                    <div class="icon-box-white">
                        <i class="mdi mdi-email-open-outline icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card shadow-sm border-0 bg-gradient-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-2 text-white-50">Abunəçilər</p>
                        <h3 class="mb-0">@Model.SubscribersCount</h3>
                    </div>
                    <div class="icon-box-white">
                        <i class="mdi mdi-account-group-outline icon-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-md-8 grid-margin stretch-card">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Son Sifarişlər</h4>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-link text-primary text-decoration-none">Hamısına bax</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Müştəri</th>
                                <th>Məbləğ</th>
                                <th>Status</th>
                                <th>Tarix</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders.Any())
                            {
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded-circle p-2 me-2">
                                                    <i class="mdi mdi-account text-secondary"></i>
                                                </div>
                                                <div>
                                                    <p class="mb-0 fw-bold">@order.CustomerName</p>
                                                    <small class="text-muted">@order.CustomerEmail</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-bold">@order.TotalPrice.ToString("C2")</td>
                                        <td>
                                            @{
                                                string badgeClass = order.Status switch
                                                {
                                                    CANNESCAKE.Models.OrderStatus.Gözləmədə => "bg-warning",
                                                    CANNESCAKE.Models.OrderStatus.Təsdiqləndi => "bg-info",
                                                    CANNESCAKE.Models.OrderStatus.Hazırlanır => "bg-primary",
                                                    CANNESCAKE.Models.OrderStatus.Çatdırılır => "bg-secondary",
                                                    CANNESCAKE.Models.OrderStatus.Tamamlandı => "bg-success",
                                                    CANNESCAKE.Models.OrderStatus.Ləğvedildi => "bg-danger",
                                                    _ => "bg-light text-dark"
                                                };
                                            }
                                            <span class="badge @badgeClass">@order.Status</span>
                                        </td>
                                        <td>@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Hələlik heç bir sifariş yoxdur.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Messages -->
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Son Mesajlar</h4>
                    <a asp-controller="ContactMessages" asp-action="Index" class="btn btn-sm btn-link text-primary text-decoration-none">Hamısına bax</a>
                </div>
                <div class="message-list mt-3">
                    @if (Model.RecentMessages.Any())
                    {
                        @foreach (var msg in Model.RecentMessages)
                        {
                            <div class="d-flex align-items-start mb-4">
                                <div class="bg-primary-subtle rounded p-2 me-3">
                                    <i class="mdi mdi-email-outline text-primary"></i>
                                </div>
                                <div class="w-100 border-bottom pb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 fw-bold">@msg.Name</h6>
                                        <small class="text-muted">@msg.CreatedDate.ToString("HH:mm")</small>
                                    </div>
                                    <p class="text-muted small mb-0 text-truncate" style="max-width: 200px;">@msg.Message</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">Mesaj yoxdur.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-text {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
    }

    .bg-gradient-primary {
        background: linear-gradient(45deg, #4e73df 0%, #224abe 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(45deg, #1cc88a 0%, #13855c 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(45deg, #36b9cc 0%, #258391 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(45deg, #f6c23e 0%, #dda20a 100%);
    }

    .icon-box-white {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-lg {
        font-size: 1.5rem;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .table thead th {
        border-top: 0;
        border-bottom-width: 1px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #888;
        padding: 12px 15px;
    }

    .table td {
        padding: 15px;
        border-bottom: 1px solid #f8f9fc;
    }

    .badge {
        font-weight: 500;
        padding: 0.5em 0.75em;
        border-radius: 6px;
    }

    .bg-primary-subtle {
        background-color: rgba(78, 115, 223, 0.1);
    }
</style>

</div>