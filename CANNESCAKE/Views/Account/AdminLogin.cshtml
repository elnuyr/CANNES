@model CANNESCAKE.Models.ViewModels.LoginViewModel

@{
    Layout = null; // Admin login often has its own specialized layout
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>CANNESCAKE - Admin Girişi</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/admin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/css/vendor.bundle.base.css">
    <!-- endinject -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/admin/assets/css/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/admin/assets/images/favicon.ico" />
    <style>
        .auth-form-light {
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .btn-primary {
            background: linear-gradient(45deg, #4e73df 0%, #224abe 100%);
            border: none;
        }
        .brand-logo {
            margin-bottom: 2rem;
            text-align: center;
        }
        .brand-logo h1 {
            color: #4e73df;
            font-weight: 800;
            letter-spacing: 2px;
        }
    </style>
</head>

<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                            <div class="brand-logo">
                                <h1 class="text-uppercase">CANNESCAKE</h1>
                                <p class="text-muted small">ADMINISTRATION PANEL</p>
                            </div>
                            <h4>Xoş gəlmisiniz!</h4>
                            <h6 class="font-weight-light text-muted mb-4">Davam etmək üçün daxil olun.</h6>
                            <form class="pt-3" asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                                <div class="form-group">
                                    <input asp-for="Username" class="form-control form-control-lg border-left-0" style="border-radius: 10px;" placeholder="İstifadəçi adı">
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                                <div class="form-group">
                                    <input asp-for="Password" type="password" class="form-control form-control-lg border-left-0" style="border-radius: 10px;" placeholder="Şifrə">
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn w-100" style="border-radius: 10px;" type="submit">DAXİL OL</button>
                                </div>
                                <div class="my-2 d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <label class="form-check-label text-muted">
                                            <input asp-for="RememberMe" type="checkbox" class="form-check-input">
                                            Məni xatırla
                                        </label>
                                    </div>
                                </div>
                                <div class="text-center mt-4 font-weight-light small">
                                    Əsas sayta qayıt <a asp-controller="Home" asp-action="Index" class="text-primary">Bura klikləyin</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="~/admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- inject:js -->
    <script src="~/admin/assets/js/off-canvas.js"></script>
    <script src="~/admin/assets/js/hoverable-collapse.js"></script>
    <script src="~/admin/assets/js/template.js"></script>
    <!-- endinject -->
</body>

</html>
